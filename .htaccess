# ============================================================
# Schwimmschule Fröschlein — .htaccess (1blu / Apache)
# ============================================================

# --- HTTPS erzwingen und auf die www-Adresse vereinheitlichen -----------
<IfModule mod_rewrite.c>
  RewriteEngine On

  # Adresse ohne www -> https://www.… (ein Schritt, auch von http aus)
  RewriteCond %{HTTP_HOST} ^schwimmschule-froeschlein\.de$ [NC]
  RewriteRule ^ https://www.schwimmschule-froeschlein.de%{REQUEST_URI} [L,R=301]

  # http -> https
  RewriteCond %{HTTPS} !=on
  RewriteCond %{HTTP:X-Forwarded-Proto} !=https
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]
</IfModule>

# --- Eigene Fehlerseite ------------------------------------------------
ErrorDocument 404 /404.html

# --- Verzeichnislisting aus, keine Versionsangabe -----------------------
Options -Indexes
ServerSignature Off

# --- Sensible Dateien sperren ------------------------------------------
<FilesMatch "^\.(?!well-known)|\.(md|log|bak|sh|ini|json|lock|yml|yaml)$">
  Require all denied
</FilesMatch>

# --- Sicherheits-Header -----------------------------------------------
<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=()"
  Header always set Cross-Origin-Opener-Policy "same-origin"

  # HSTS erst aktivieren, wenn HTTPS dauerhaft einwandfrei läuft
  # Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains"

  # Content-Security-Policy: nur eigene Dateien; Kartenkacheln von OpenStreetMap; Reichweitenmessung GoatCounter
  Header always set Content-Security-Policy "default-src 'self'; script-src 'self' https://gc.zgo.at https://beckenrand.app; style-src 'self' 'unsafe-inline' https://beckenrand.app; img-src 'self' data: https://beckenrand.app https://*.tile.openstreetmap.org https://schwimmschulefroeschlein.goatcounter.com; font-src 'self'; connect-src 'self' https://schwimmschulefroeschlein.goatcounter.com https://beckenrand.app; frame-ancestors 'self'; base-uri 'self'; form-action 'self' mailto: https://beckenrand.app; object-src 'self'; frame-src 'self' https://beckenrand.app"
</IfModule>

# --- Kompression & Caching ---------------------------------------------
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript image/svg+xml
</IfModule>
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType image/png "access plus 1 month"
  ExpiresByType image/jpeg "access plus 1 month"
  ExpiresByType image/svg+xml "access plus 1 month"
  ExpiresByType font/woff2 "access plus 1 year"
  ExpiresByType text/css "access plus 1 week"
  ExpiresByType application/javascript "access plus 1 week"
</IfModule>
